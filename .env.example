PORT=3000

# Postgres (BKKBN) — primary MV lookup
DB_HOST=your-db-host.example.com
DB_PORT=5435
DB_NAME=BKKBN
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Postgres (BKKBN_SIGA) — nama_pasangan / tanggal_cabut_lepas from dat_PelayananKBDetil
# If unset/unreachable, API still returns MV data with those fields as "-"
SIGA_DB_HOST=
SIGA_DB_PORT=5435
SIGA_DB_NAME=BKKBN_SIGA
SIGA_DB_USER=
SIGA_DB_PASSWORD=
SIGA_DB_SSL=false

# API key auth — send as header X-API-Key on /api/kb/*
API_KEY=change-me-to-a-long-random-string

# Legacy JWT auth (unused; kept for reference)
# JWT_SECRET=
# JWT_EXPIRES_IN=8h
# AUTH_USERNAME=mitra_bkkbn
# AUTH_PASSWORD=
